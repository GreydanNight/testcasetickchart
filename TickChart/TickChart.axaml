<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:TickChartControl"
                    xmlns:scottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia">

	<ControlTheme x:Key="{x:Type local:TickChart}" TargetType="local:TickChart">
		<Setter Property="Template">
			<ControlTemplate>
				<scottPlot:AvaPlot Name="PART_PlotView" />
			</ControlTemplate>
		</Setter>
	</ControlTheme>

</ResourceDictionary>

